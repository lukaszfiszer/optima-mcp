  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "mssql": "^11.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.7",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
