{
  "name": "optima-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server over a Comarch ERP Optima company database",
  "license": "MIT",
  "type": "module",
  "bin": {
    "optima-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
